# Pollar publishable key. Self-serve at https://dashboard.pollar.xyz (Build -> API Keys).
# Use pub_testnet_... while developing, pub_mainnet_... for real money.
VITE_POLLAR_PUBLISHABLE_KEY=

# Which Stellar network the app talks to: testnet | mainnet
VITE_STELLAR_NETWORK=testnet

# USDC issuer. Defaults are baked in for both networks; override only if you know why.
# mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# testnet: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
VITE_USDC_ISSUER=
