{
  "name": "susunaku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rotating savings circles with no custodian. Members pay each round's recipient directly in USDC on Stellar.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "pollar:check": "node scripts/check-pollar.mjs",
    "member:new": "node scripts/make-usdc-member.mjs",
    "verify:leg": "node scripts/verify-leg.mjs"
  },
  "dependencies": {
    "@pollar/core": "^0.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
